{
  "name": "pm2-captain",
  "version": "1.4.0",
  "description": "A local web control room for PM2 processes and logs",
  "author": "Ivan Pantic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panta82/pm2-captain.git"
  },
  "homepage": "https://github.com/panta82/pm2-captain#readme",
  "bugs": {
    "url": "https://github.com/panta82/pm2-captain/issues"
  },
  "keywords": [
    "pm2",
    "process-manager",
    "dashboard",
    "logs",
    "monitoring"
  ],
  "main": "dist/backend/app.js",
  "bin": {
    "pm2-captain": "dist/backend/app.js"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development SERVER_DEV_MODE=true DEBUG=true tsx watch src/backend/app.ts",
    "dev:fake": "cross-env NODE_ENV=development SERVER_DEV_MODE=true DEBUG=true tsx watch src/backend/app.ts --fake",
    "start": "node dist/backend/app.js",
    "build": "bash support/build.sh",
    "build:frontend": "vite build",
    "build:backend": "bash support/build-backend.sh",
    "generate:icons": "bash support/generate-icons.sh",
    "typecheck": "tsc --noEmit --project src/backend/tsconfig.json && tsc --noEmit --project src/frontend/tsconfig.json && tsc --noEmit --project tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "cross-env CAPTAIN_PERFORMANCE=1 playwright test fake_performance.test.ts --project=fake",
    "test:frames": "cross-env CAPTAIN_FRAMES=1 playwright test fake_frames.test.ts --project=fake",
    "test:package": "bash support/test-package.sh",
    "release:check": "npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run build",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/middie": "9.3.3",
    "@fastify/static": "10.1.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.10.0",
    "lucide-react": "1.26.0",
    "pino": "10.3.1",
    "pm2": "7.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "cross-env": "10.1.0",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
